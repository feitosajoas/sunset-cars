@model SunsetCars.Services.SalesReportData
@{
    ViewData["Title"] = "Relatório Mensal";
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-file-alt text-primary me-2"></i>Relatório @Model.Month.ToString("00")/@Model.Year</h2>
            <p class="text-muted mb-0">Total de vendas: <strong>@Model.TotalSales</strong> | Receita: <strong>@Model.TotalRevenue.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></p>
        </div>
        <div class="btn-group">
            <a asp-action="Monthly" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Novo Período</a>
            <a asp-action="ExportPdf" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-danger"><i class="fas fa-file-pdf me-2"></i>PDF</a>
            <a asp-action="ExportExcel" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-success"><i class="fas fa-file-excel me-2"></i>Excel</a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-header bg-light"><h5 class="mb-0"><i class="fas fa-car me-2"></i>Por Tipo</h5></div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead><tr><th>Tipo</th><th class="text-end">Qtd</th><th class="text-end">Receita</th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.SalesByVehicleType)
                            {
                                <tr>
                                    <td>@i.VehicleType</td>
                                    <td class="text-end">@i.Count</td>
                                    <td class="text-end">@i.Revenue.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-header bg-light"><h5 class="mb-0"><i class="fas fa-building me-2"></i>Por Concessionária</h5></div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead><tr><th>Concessionária</th><th class="text-end">Qtd</th><th class="text-end">Receita</th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.SalesByDealership)
                            {
                                <tr>
                                    <td>@i.DealershipName</td>
                                    <td class="text-end">@i.Count</td>
                                    <td class="text-end">@i.Revenue.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-header bg-light"><h5 class="mb-0"><i class="fas fa-industry me-2"></i>Por Fabricante</h5></div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead><tr><th>Fabricante</th><th class="text-end">Qtd</th><th class="text-end">Receita</th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.SalesByManufacturer)
                            {
                                <tr>
                                    <td>@i.ManufacturerName</td>
                                    <td class="text-end">@i.Count</td>
                                    <td class="text-end">@i.Revenue.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
