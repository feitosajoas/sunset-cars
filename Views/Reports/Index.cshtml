@{
    ViewData["Title"] = "Relatórios";
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-chart-bar text-primary me-2"></i>Relatórios</h2>
            <p class="text-muted mb-0">Dashboard e exportações</p>
        </div>
        <a asp-action="Monthly" class="btn btn-primary"><i class="fas fa-calendar me-2"></i>Relatório Mensal</a>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header bg-light"><h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Vendas (últimos 6 meses)</h5></div>
                <div class="card-body"><canvas id="monthlySalesChart" height="140"></canvas></div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header bg-light"><h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Vendas por Tipo (mês atual)</h5></div>
                <div class="card-body"><canvas id="salesByTypeChart" height="140"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Line chart - monthly sales
        fetch('@Url.Action("GetMonthlySalesData")')
            .then(r => r.json())
            .then(data => {
                const ctx = document.getElementById('monthlySalesChart');
                new Chart(ctx, {
                    type: 'line',
                    data,
                    options: { responsive: true, maintainAspectRatio: false }
                });
            });

        // Pie chart - sales by type
        fetch('@Url.Action("GetSalesByTypeData")')
            .then(r => r.json())
            .then(data => {
                const ctx = document.getElementById('salesByTypeChart');
                new Chart(ctx, {
                    type: 'pie',
                    data,
                    options: { responsive: true, maintainAspectRatio: false }
                });
            });
    </script>
}
