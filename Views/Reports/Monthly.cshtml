@{
    ViewData["Title"] = "Relatório Mensal";
    var selectedYear = ViewBag.Year as int? ?? DateTime.Now.Year;
    var selectedMonth = ViewBag.Month as int? ?? DateTime.Now.Month;
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-calendar text-primary me-2"></i>Relatório Mensal</h2>
            <p class="text-muted mb-0">Selecione o período para gerar o relatório</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Voltar</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Monthly" method="post" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Ano</label>
                    <input name="year" value="@selectedYear" type="number" min="2020" max="2100" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Mês</label>
                    <select name="month" class="form-select">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m==selectedMonth)">@m.ToString("00")</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-search me-2"></i>Gerar</button>
                </div>
            </form>
        </div>
    </div>
</div>
