@{
    ViewData["Title"] = "Gestão de Vendas";
}

<div class="container-fluid">
    <!-- Header da Página -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-handshake text-primary me-2"></i>
                        Gestão de Vendas
                    </h2>
                    <p class="text-muted mb-0">Gerencie todas as vendas registradas no sistema</p>
                </div>
                <div>
                    <a href="/Sales/Create" class="btn btn-md btn-primary">
                        <i class="fas fa-plus me-2"></i>
                        Nova Venda
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Card de Estatísticas -->
    <div class="row mb-4" id="statsCards">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0" id="totalSales">0</h4>
                            <small>Total de Vendas</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-handshake fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0" id="totalRevenue">R$ 0,00</h4>
                            <small>Receita Total</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-dollar-sign fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0" id="salesToday">0</h4>
                            <small>Vendas Hoje</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-calendar-day fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0" id="salesThisMonth">0</h4>
                            <small>Vendas Este Mês</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-calendar-alt fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros de Busca -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text" id="searchInput" class="form-control"
                        placeholder="Buscar por protocolo, cliente ou veículo..." />
                </div>
                <div class="col-md-3">
                    <select id="dealershipFilter" class="form-select">
                        <option value="">Todas as Concessionárias</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="customerFilter" class="form-select">
                        <option value="">Todos os Clientes</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="button" id="clearFilters" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-times me-1"></i>Limpar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Vendas -->
    <div class="card">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="fas fa-list me-2"></i>
                Lista de Vendas (<span id="resultsCount">0</span> resultado(s))
            </h5>
        </div>
        <div class="card-body p-0">
            <!-- Loading state -->
            <div id="loadingIndicator" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
                <p class="mt-3 text-muted">Carregando vendas...</p>
            </div>

            <!-- Tabela -->
            <div id="salesTable" class="d-none">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center" style="width: 80px;">ID</th>
                                <th>Data</th>
                                <th>Cliente</th>
                                <th>CPF</th>
                                <th>Veículo</th>
                                <th>Concessionária</th>
                                <th class="text-end">Preço</th>
                                <th>Protocolo</th>
                                <th class="text-center" style="width: 200px;">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="salesTableBody">
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Estado vazio -->
            <div id="emptyState" class="text-center py-5 d-none">
                <div class="mb-4">
                    <i class="fas fa-handshake fa-3x text-muted"></i>
                </div>
                <h4 class="text-muted">Nenhuma venda encontrada</h4>
                <p class="text-muted mb-4">Comece registrando sua primeira venda no sistema.</p>
                <a href="/Sales/Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>
                    Registrar Primeira Venda
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Confirmar Exclusão
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0 me-3">
                        <i class="fas fa-exclamation-triangle fa-2x text-warning"></i>
                    </div>
                    <div>
                        <h6>Tem certeza que deseja excluir esta venda?</h6>
                        <p class="mb-0">
                            A venda <strong id="saleProtocol"></strong> será excluída permanentemente.
                            Esta ação não pode ser desfeita.
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>
                    Cancelar
                </button>
                <button type="button" id="confirmDelete" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>
                    Excluir Venda
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let sales = [];
            let dealerships = [];
            let customers = [];
            let currentDeleteId = null;

            // Elementos do DOM
            const loadingIndicator = document.getElementById('loadingIndicator');
            const salesTable = document.getElementById('salesTable');
            const emptyState = document.getElementById('emptyState');
            const salesTableBody = document.getElementById('salesTableBody');
            const searchInput = document.getElementById('searchInput');
            const dealershipFilter = document.getElementById('dealershipFilter');
            const customerFilter = document.getElementById('customerFilter');
            const clearFiltersBtn = document.getElementById('clearFilters');
            const resultsCount = document.getElementById('resultsCount');

            // Carregar dados iniciais
            Promise.all([loadSales(), loadDealerships(), loadCustomers()])
                .then(() => {
                    renderSalesTable(sales);
                    updateStats();
                })
                .catch(error => {
                    console.error('Erro ao carregar dados:', error);
                    showError();
                });

            // Event listeners para filtros
            searchInput.addEventListener('input', debounce(filterSales, 300));
            dealershipFilter.addEventListener('change', filterSales);
            customerFilter.addEventListener('change', filterSales);
            clearFiltersBtn.addEventListener('click', clearFilters);

            // Função para carregar vendas
            async function loadSales() {
                try {
                    const response = await fetch('/api/sales', {
                        credentials: 'same-origin'
                    });

                    if (!response.ok) {
                        throw new Error('Erro ao carregar vendas');
                    }

                    sales = await response.json();
                } catch (error) {
                    console.error('Erro ao carregar vendas:', error);
                    throw error;
                }
            }

            // Função para carregar concessionárias
            async function loadDealerships() {
                try {
                    const response = await fetch('/api/dealerships', {
                        credentials: 'same-origin'
                    });

                    if (!response.ok) {
                        throw new Error('Erro ao carregar concessionárias');
                    }

                    dealerships = await response.json();
                    populateDealershipFilter();
                } catch (error) {
                    console.error('Erro ao carregar concessionárias:', error);
                    throw error;
                }
            }

            // Função para carregar clientes
            async function loadCustomers() {
                try {
                    const response = await fetch('/api/customers', {
                        credentials: 'same-origin'
                    });

                    if (!response.ok) {
                        throw new Error('Erro ao carregar clientes');
                    }

                    customers = await response.json();
                    populateCustomerFilter();
                } catch (error) {
                    console.error('Erro ao carregar clientes:', error);
                    throw error;
                }
            }

            // Função para popular o filtro de concessionárias
            function populateDealershipFilter() {
                dealershipFilter.innerHTML = '<option value="">Todas as Concessionárias</option>';
                dealerships.forEach(dealership => {
                    const option = document.createElement('option');
                    option.value = dealership.Id;
                    option.textContent = dealership.Name;
                    dealershipFilter.appendChild(option);
                });
            }

            // Função para popular o filtro de clientes
            function populateCustomerFilter() {
                customerFilter.innerHTML = '<option value="">Todos os Clientes</option>';
                customers.forEach(customer => {
                    const option = document.createElement('option');
                    option.value = customer.Id;
                    option.textContent = customer.Name;
                    customerFilter.appendChild(option);
                });
            }

            // Função para renderizar a tabela
            function renderSalesTable(salesToRender) {
                loadingIndicator.classList.add('d-none');
                
                if (salesToRender.length === 0) {
                    salesTable.classList.add('d-none');
                    emptyState.classList.remove('d-none');
                    resultsCount.textContent = '0';
                    return;
                }

                emptyState.classList.add('d-none');
                salesTable.classList.remove('d-none');
                resultsCount.textContent = salesToRender.length;

                salesTableBody.innerHTML = salesToRender.map(sale => `
                    <tr>
                        <!-- ID -->
                        <td class="text-center align-middle">
                            <span class="badge bg-secondary">#${sale.Id}</span>
                        </td>

                        <!-- Data -->
                        <td class="align-middle">
                            <div>
                                <strong>${formatDate(sale.SaleDate)}</strong>
                                <br><small class="text-muted">${formatTime(sale.SaleDate)}</small>
                            </div>
                        </td>

                        <!-- Cliente -->
                        <td class="align-middle">
                            <div>
                                <h6 class="mb-1 fw-semibold">${sale.CustomerName || 'N/A'}</h6>
                            </div>
                        </td>

                        <!-- CPF -->
                        <td class="align-middle">
                            <span class="badge bg-light text-dark">
                                ${sale.CustomerCpf || 'N/A'}
                            </span>
                        </td>

                        <!-- Veículo -->
                        <td class="align-middle">
                            <div>
                                <strong>${sale.VehicleModel || 'N/A'}</strong>
                                <br><small class="text-muted">${sale.ManufacturerName || ''}</small>
                            </div>
                        </td>

                        <!-- Concessionária -->
                        <td class="align-middle">
                            <span class="badge bg-info">
                                ${sale.DealershipName || 'N/A'}
                            </span>
                        </td>

                        <!-- Preço -->
                        <td class="text-end align-middle">
                            <strong class="text-success fs-6">
                                ${formatCurrency(sale.SalePrice)}
                            </strong>
                        </td>

                        <!-- Protocolo -->
                        <td class="align-middle">
                            <span class="badge bg-primary">
                                ${sale.Protocol}
                            </span>
                        </td>

                        <!-- Ações -->
                        <td class="text-center align-middle">
                            <div class="btn-group" role="group">
                                <!-- Visualizar -->
                                <a href="/Sales/Details/${sale.Id}"
                                    class="btn btn-outline-info btn-sm" title="Visualizar detalhes">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <!-- Editar -->
                                <a href="/Sales/Edit/${sale.Id}"
                                    class="btn btn-outline-warning btn-sm" title="Editar venda">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <!-- Excluir -->
                                <button type="button" class="btn btn-outline-danger btn-sm delete-btn" 
                                    data-sale-id="${sale.Id}"
                                    data-sale-protocol="${sale.Protocol}" 
                                    title="Excluir venda">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');

                // Adicionar event listeners aos botões de delete
                document.querySelectorAll('.delete-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const saleId = this.getAttribute('data-sale-id');
                        const saleProtocol = this.getAttribute('data-sale-protocol');
                        
                        currentDeleteId = saleId;
                        document.getElementById('saleProtocol').textContent = saleProtocol;
                        
                        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
                        modal.show();
                    });
                });
            }

            // Função para filtrar vendas
            function filterSales() {
                const searchTerm = searchInput.value.toLowerCase();
                const selectedDealership = dealershipFilter.value;
                const selectedCustomer = customerFilter.value;

                const filteredSales = sales.filter(sale => {
                    const matchesSearch = !searchTerm || 
                        sale.Protocol.toLowerCase().includes(searchTerm) ||
                        sale.CustomerName.toLowerCase().includes(searchTerm) ||
                        sale.CustomerCpf.toLowerCase().includes(searchTerm) ||
                        sale.VehicleModel.toLowerCase().includes(searchTerm) ||
                        sale.DealershipName.toLowerCase().includes(searchTerm);
                    
                    const matchesDealership = !selectedDealership || 
                        sale.DealershipId.toString() === selectedDealership;
                    
                    const matchesCustomer = !selectedCustomer || 
                        sale.CustomerId.toString() === selectedCustomer;

                    return matchesSearch && matchesDealership && matchesCustomer;
                });

                renderSalesTable(filteredSales);
            }

            // Função para limpar filtros
            function clearFilters() {
                searchInput.value = '';
                dealershipFilter.value = '';
                customerFilter.value = '';
                renderSalesTable(sales);  
            }

            // Função para atualizar estatísticas
            function updateStats() {
                const total = sales.length;
                const totalRevenue = sales.reduce((sum, sale) => sum + sale.SalePrice, 0);
                const today = new Date().toDateString();
                const salesToday = sales.filter(s => new Date(s.SaleDate).toDateString() === today).length;
                const thisMonth = sales.filter(s => {
                    const saleDate = new Date(s.SaleDate);
                    const now = new Date();
                    return saleDate.getMonth() === now.getMonth() && saleDate.getFullYear() === now.getFullYear();
                }).length;

                document.getElementById('totalSales').textContent = total;
                document.getElementById('totalRevenue').textContent = formatCurrency(totalRevenue);
                document.getElementById('salesToday').textContent = salesToday;
                document.getElementById('salesThisMonth').textContent = thisMonth;
            }

            // Confirmar exclusão
            document.getElementById('confirmDelete').addEventListener('click', async function() {
                if (!currentDeleteId) return;

                try {
                    const response = await fetch(`/api/sales/${currentDeleteId}`, {
                        method: 'DELETE',
                        credentials: 'same-origin'
                    });

                    if (response.ok) {
                        // Recarregar dados
                        await loadSales();
                        renderSalesTable(sales);
                        updateStats();
                        
                        // Fechar modal
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        
                        // Mostrar sucesso
                        showToast('Venda excluída com sucesso!', 'success');
                    } else {
                        const errorData = await response.json();
                        showToast(errorData.error || 'Erro ao excluir venda', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao excluir venda:', error);
                    showToast('Erro ao excluir venda', 'error');
                }
            });

            // Funções utilitárias
            function formatDate(dateString) {
                return new Date(dateString).toLocaleDateString('pt-BR');
            }

            function formatTime(dateString) {
                return new Date(dateString).toLocaleTimeString('pt-BR', {
                    hour: '2-digit',
                    minute: '2-digit'
                });
            }

            function formatCurrency(value) {
                return new Intl.NumberFormat('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                }).format(value);
            }

            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }

            function showError() {
                loadingIndicator.innerHTML = `
                    <div class="text-center py-5">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                        <h4 class="text-danger">Erro ao carregar dados</h4>
                        <p class="text-muted">Tente recarregar a página</p>
                        <button class="btn btn-primary" onclick="location.reload()">
                            <i class="fas fa-refresh me-2"></i>Recarregar
                        </button>
                    </div>
                `;
            }

            function showToast(message, type) {
                // Criar toast dinamicamente
                const toastHtml = `
                    <div class="toast align-items-center text-white ${type === 'success' ? 'bg-success' : 'bg-danger'} border-0" role="alert">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas ${type === 'success' ? 'fa-check' : 'fa-exclamation-triangle'} me-2"></i>
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                `;
                
                // Adicionar ao container de toasts (criar se não existir)
                let toastContainer = document.getElementById('toast-container');
                if (!toastContainer) {
                    toastContainer = document.createElement('div');
                    toastContainer.id = 'toast-container';
                    toastContainer.className = 'toast-container position-fixed top-0 end-0 p-3';
                    document.body.appendChild(toastContainer);
                }
                
                toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                
                // Inicializar e mostrar o toast
                const toastElement = toastContainer.lastElementChild;
                const toast = new bootstrap.Toast(toastElement);
                toast.show();
                
                // Remover o elemento após esconder
                toastElement.addEventListener('hidden.bs.toast', () => {
                    toastElement.remove();
                });
            }
        });
    </script>
}

@section Styles {
    <style>
        .table th {
            border-top: none;
            font-weight: 600;
            font-size: 0.875rem;
        }

        .table td {
            vertical-align: middle;
        }

        .btn-group .btn {
            border-radius: 0.375rem !important;
            margin-right: 2px;
        }

        .btn-group .btn:last-child {
            margin-right: 0;
        }

        .card-header {
            border-bottom: 2px solid #dee2e6;
        }

        .badge {
            font-size: 0.75rem;
            font-weight: 500;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0, 123, 255, 0.05);
        }

        .table-responsive {
            border-radius: 0.5rem;
        }

        .card {
            border: none;
            border-radius: 0.75rem;
        }
    </style>
}