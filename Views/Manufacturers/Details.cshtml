@{
    ViewData["Title"] = "Detalhes do Fabricante";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1"><i class="fas fa-eye text-info me-2"></i>Detalhes do Fabricante</h2>
                <p class="text-muted mb-0">Visualize as informações do fabricante</p>
            </div>
            <div>
                <a href="/Manufacturers" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Voltar à Lista
                </a>
            </div>
        </div>
    </div>

    <!-- Loading state -->
    <div id="loadingIndicator" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
        <p class="mt-3 text-muted">Carregando detalhes do fabricante...</p>
    </div>

    <div id="manufacturerDetails" class="row d-none">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0" id="manufacturerTitle">
                        <i class="fas fa-industry me-2"></i>Carregando...
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8" id="manufacturerId">#-</dd>

                        <dt class="col-sm-4">Nome</dt>
                        <dd class="col-sm-8" id="manufacturerName">-</dd>

                        <dt class="col-sm-4">País</dt>
                        <dd class="col-sm-8" id="manufacturerCountry">-</dd>

                        <dt class="col-sm-4">Ano Fundação</dt>
                        <dd class="col-sm-8" id="manufacturerFoundedYear">-</dd>

                        <dt class="col-sm-4">Website</dt>
                        <dd class="col-sm-8" id="manufacturerWebsite">-</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8" id="manufacturerStatus">-</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a id="editLink" href="#" class="btn btn-warning text-dark">
                        <i class="fas fa-edit me-2"></i>Editar
                    </a>
                    <button id="deleteButton" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Excluir
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-car me-2"></i>
                        Veículos (<span id="vehiclesCount">0</span>)
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Loading state for vehicles -->
                    <div id="vehiclesLoading" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Carregando veículos...</span>
                        </div>
                    </div>

                    <!-- Vehicles list -->
                    <div id="vehiclesList" class="d-none">
                        <ul id="vehiclesUl" class="list-group list-group-flush">
                        </ul>
                    </div>

                    <!-- Empty state -->
                    <div id="vehiclesEmpty" class="text-center py-3 text-muted d-none">
                        <i class="fas fa-car fa-2x mb-2 opacity-50"></i>
                        <p class="mb-0">Nenhum veículo cadastrado para este fabricante.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const manufacturerId = window.location.pathname.split('/').pop();
            
            if (!manufacturerId || manufacturerId === 'Details') {
                window.location.href = '/Manufacturers';
                return;
            }

            loadManufacturerDetails(manufacturerId);

            async function loadManufacturerDetails(id) {
                try {
                    // Carregar dados do fabricante e veículos em paralelo
                    const [manufacturerResponse, vehiclesResponse] = await Promise.all([
                        fetch(`/api/manufacturers/${id}`, { credentials: 'same-origin' }),
                        fetch(`/api/manufacturers/${id}/vehicles`, { credentials: 'same-origin' })
                    ]);

                    if (!manufacturerResponse.ok) {
                        throw new Error('Fabricante não encontrado');
                    }

                    const manufacturer = await manufacturerResponse.json();
                    populateDetails(manufacturer);
                    
                    // Carregar veículos (mesmo se der erro, ainda mostra o fabricante)
                    if (vehiclesResponse.ok) {
                        const vehicles = await vehiclesResponse.json();
                        populateVehicles(vehicles);
                    } else {
                        populateVehicles([]);
                    }
                    
                    document.getElementById('loadingIndicator').classList.add('d-none');
                    document.getElementById('manufacturerDetails').classList.remove('d-none');
                } catch (error) {
                    console.error('Erro ao carregar fabricante:', error);
                    showError();
                }
            }

            function populateDetails(manufacturer) {
                document.getElementById('manufacturerTitle').innerHTML = `
                    <i class="fas fa-industry me-2"></i>${manufacturer.Name}
                `;
                document.getElementById('manufacturerId').textContent = `#${manufacturer.Id}`;
                document.getElementById('manufacturerName').textContent = manufacturer.Name || 'N/A';
                document.getElementById('manufacturerCountry').textContent = manufacturer.Country || 'N/A';
                document.getElementById('manufacturerFoundedYear').textContent = manufacturer.FoundedYear || 'N/A';
                
                const websiteElement = document.getElementById('manufacturerWebsite');
                if (manufacturer.Website) {
                    websiteElement.innerHTML = `<a href="${manufacturer.Website}" target="_blank" class="text-decoration-none">
                        <i class="fas fa-external-link-alt me-1"></i>${manufacturer.Website}
                    </a>`;
                } else {
                    websiteElement.textContent = '-';
                }
                
                document.getElementById('manufacturerStatus').innerHTML = manufacturer.IsActive ? 
                    '<span class="badge bg-success"><i class="fas fa-check me-1"></i> Ativo</span>' :
                    '<span class="badge bg-danger"><i class="fas fa-times me-1"></i> Inativo</span>';

                // Atualizar links
                document.getElementById('editLink').href = `/Manufacturers/Edit/${manufacturer.Id}`;
                
                // Configurar botão de exclusão
                const deleteButton = document.getElementById('deleteButton');
                deleteButton.addEventListener('click', function() {
                    document.getElementById('deleteManufacturerName').textContent = manufacturer.Name;
                    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
                    modal.show();
                });

                // Configurar confirmação de exclusão
                document.getElementById('confirmDelete').addEventListener('click', async function() {
                    try {
                        const response = await fetch(`/api/manufacturers/${manufacturer.Id}`, {
                            method: 'DELETE',
                            credentials: 'same-origin'
                        });

                        if (response.ok) {
                            // Fechar modal
                            bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                            
                            // Mostrar sucesso
                            showToast('Fabricante excluído com sucesso!', 'success');
                            
                            // Redirecionar após um tempo
                            setTimeout(() => {
                                window.location.href = '/Manufacturers';
                            }, 2000);
                        } else {
                            const errorData = await response.json();
                            showToast(errorData.error || 'Erro ao excluir fabricante', 'error');
                        }
                    } catch (error) {
                        console.error('Erro ao excluir fabricante:', error);
                        showToast('Erro ao excluir fabricante', 'error');
                    }
                });
            }

            function populateVehicles(vehicles) {
                document.getElementById('vehiclesLoading').classList.add('d-none');
                document.getElementById('vehiclesCount').textContent = vehicles.length;

                if (vehicles.length === 0) {
                    document.getElementById('vehiclesEmpty').classList.remove('d-none');
                    return;
                }

                document.getElementById('vehiclesList').classList.remove('d-none');
                const vehiclesUl = document.getElementById('vehiclesUl');
                
                vehiclesUl.innerHTML = vehicles.map(vehicle => `
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>${vehicle.Model}</strong> (${vehicle.Year})
                            <div class="small text-muted">
                                ${formatCurrency(vehicle.Price)} • ${getTypeName(vehicle.Type)}
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            ${vehicle.IsActive ? 
                                '<span class="badge bg-success">Disponível</span>' :
                                '<span class="badge bg-danger">Vendido</span>'
                            }
                            <a href="/Vehicles/Details/${vehicle.Id}" class="btn btn-outline-info btn-sm">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </li>
                `).join('');
            }

            function getTypeName(type) {
                const typeNames = {
                    1: 'Carro',
                    2: 'Moto', 
                    3: 'Caminhão',
                    4: 'SUV',
                    5: 'Pickup',
                    6: 'Van'
                };
                return typeNames[type] || 'N/A';
            }

            function formatCurrency(value) {
                return new Intl.NumberFormat('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                }).format(value);
            }

            function showError() {
                document.getElementById('loadingIndicator').innerHTML = `
                    <div class="text-center py-5">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                        <h4 class="text-danger">Erro ao carregar dados</h4>
                        <p class="text-muted">Não foi possível carregar os detalhes do fabricante</p>
                        <a href="/Manufacturers" class="btn btn-primary">
                            <i class="fas fa-arrow-left me-2"></i>Voltar à Lista
                        </a>
                    </div>
                `;
            }

            function showToast(message, type) {
                // Criar toast dinamicamente
                const toastHtml = `
                    <div class="toast align-items-center text-white ${type === 'success' ? 'bg-success' : 'bg-danger'} border-0" role="alert">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas ${type === 'success' ? 'fa-check' : 'fa-exclamation-triangle'} me-2"></i>
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                `;
                
                // Adicionar ao container de toasts (criar se não existir)
                let toastContainer = document.getElementById('toast-container');
                if (!toastContainer) {
                    toastContainer = document.createElement('div');
                    toastContainer.id = 'toast-container';
                    toastContainer.className = 'toast-container position-fixed top-0 end-0 p-3';
                    document.body.appendChild(toastContainer);
                }
                
                toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                
                // Inicializar e mostrar o toast
                const toastElement = toastContainer.lastElementChild;
                const toast = new bootstrap.Toast(toastElement);
                toast.show();
                
                // Remover o elemento após esconder
                toastElement.addEventListener('hidden.bs.toast', () => {
                    toastElement.remove();
                });
            }
        });
    </script>
}

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Confirmar Exclusão
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0 me-3">
                        <i class="fas fa-exclamation-triangle fa-2x text-warning"></i>
                    </div>
                    <div>
                        <h6>Tem certeza que deseja excluir este fabricante?</h6>
                        <p class="mb-0">
                            O fabricante <strong id="deleteManufacturerName"></strong> será excluído permanentemente.
                            Esta ação não pode ser desfeita.
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>
                    Cancelar
                </button>
                <button type="button" id="confirmDelete" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>
                    Excluir Fabricante
                </button>
            </div>
        </div>
    </div>
</div>
