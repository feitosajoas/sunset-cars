@{
    ViewData["Title"] = "Novo Veículo";
}

<div class="container-fluid">
    <!-- Header da Página -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-plus-circle text-success me-2"></i>
                        Novo Veículo
                    </h2>
                    <p class="text-muted mb-0">Adicione um novo veículo ao sistema</p>
                </div>
                <div>
                    <a href="/Vehicles" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Voltar à Lista
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulário -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-car me-2"></i>
                        Informações do Veículo
                    </h5>
                </div>
                <div class="card-body">
                    <div id="error-messages" class="alert alert-danger d-none"></div>
                    <div id="success-message" class="alert alert-success d-none"></div>

                    <form id="formCriarVeiculo">

                        <!-- Informações Básicas -->
                        <div class="mb-4">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-info-circle me-2"></i>
                                Informações Básicas
                            </h6>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input id="model" name="Model" class="form-control" placeholder="Modelo" required />
                                        <label for="model">Modelo <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input id="year" name="Year" class="form-control" placeholder="Ano" type="number"
                                            min="1900" max="2030" required />
                                        <label for="year">Ano <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <select id="manufacturerId" name="ManufacturerId" class="form-select" required>
                                            <option value="">Selecione o Fabricante</option>
                                        </select>
                                        <label for="manufacturerId">Fabricante <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input id="price" name="Price" class="form-control" placeholder="Preço" type="number"
                                            step="0.01" min="0" required />
                                        <label for="price">Preço (R$) <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Especificações -->
                        <div class="mb-4">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-cogs me-2"></i>
                                Especificações
                            </h6>

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-floating mb-3">
                                        <select id="type" name="Type" class="form-select" required>
                                            <option value="">Selecione o tipo</option>
                                            <option value="1">Carro</option>
                                            <option value="2">Moto</option>
                                            <option value="3">Caminhão</option>
                                            <option value="4">SUV</option>
                                            <option value="5">Pickup</option>
                                            <option value="6">Van</option>
                                        </select>
                                        <label for="type">Tipo de Veículo <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Informações Adicionais -->
                        <div class="mb-4">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-clipboard-list me-2"></i>
                                Informações Adicionais
                            </h6>

                            <div class="form-floating mb-4">
                                <textarea id="description" name="Description" class="form-control" placeholder="Descrição"
                                    style="height: 120px"></textarea>
                                <label for="description">Descrição</label>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a href="/Vehicles" class="btn btn-sm btn-outline-secondary btn-lg">
                                <i class="fas fa-times me-2"></i>
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-sm btn-success btn-lg" id="submitButton">
                                <i class="fas fa-save me-2"></i>
                                Salvar Veículo
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de Ajuda -->
            <div class="card mt-4">
                <div class="card-header bg-info text-white">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-lightbulb me-2"></i>
                        Dicas de Preenchimento
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Modelo:</strong> Use o nome comercial do veículo
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Ano:</strong> Ano de fabricação do veículo
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Fabricante:</strong> Escolha da lista disponível
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Preço:</strong> Valor de venda sugerido
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Tipo:</strong> Categoria do veículo
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Descrição:</strong> Destaque os principais atributos
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('formCriarVeiculo');
            if (!form) {
                return;
            }

            // Carregar fabricantes
            loadManufacturers();

            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const data = {
                    ManufacturerId: parseInt(document.getElementById('manufacturerId').value),
                    Model: document.getElementById('model').value,
                    Year: parseInt(document.getElementById('year').value),
                    Price: parseFloat(document.getElementById('price').value),
                    Type: parseInt(document.getElementById('type').value),
                    Description: document.getElementById('description').value
                };

                const errorMessages = document.getElementById('error-messages');
                const successMessage = document.getElementById('success-message');
                
                if (errorMessages) {
                    errorMessages.classList.add('d-none');
                    errorMessages.innerHTML = '';
                }
                if (successMessage) {
                    successMessage.classList.add('d-none');
                    successMessage.textContent = '';
                }
                
                document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
                document.querySelectorAll('.invalid-feedback').forEach(el => el.textContent = '');

                const submitButton = document.getElementById('submitButton');
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Salvando...';
                }

                fetch('/api/vehicles', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data),
                    credentials: 'same-origin'
                })
                .then(response => {
                    if (response.ok) {
                        return response.json().then(data => data).catch(() => ({ success: true }));
                    } else if (response.status === 400) {
                        return response.json().then(data => {
                            return Promise.reject({
                                type: 'validation',
                                status: 400,
                                data: data
                            });
                        }).catch(() => {
                            return Promise.reject({
                                type: 'error',
                                status: 400,
                                message: 'Dados inválidos'
                            });
                        });
                    } else if (response.status === 401) {
                        window.location.href = '/Identity/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                        return;
                    } else if (response.status >= 500) {
                        return Promise.reject({
                            type: 'error',
                            status: response.status,
                            message: 'Erro interno do servidor. Tente novamente mais tarde.'
                        });
                    } else {
                        return Promise.reject({
                            type: 'error',
                            status: response.status,
                            message: `Erro inesperado: ${response.status} ${response.statusText}`
                        });
                    }
                })
                .then(result => {
                    const successMessage = document.getElementById('success-message');
                    const form = document.getElementById('formCriarVeiculo');
                    
                    if (successMessage) {
                        const vehicleModel = result.model || document.getElementById('model').value;
                        successMessage.innerHTML = `
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Sucesso!</strong> Veículo "${vehicleModel}" foi criado com sucesso!
                            <br><small class="mt-1 d-block">Redirecionando em 3 segundos...</small>
                        `;
                        successMessage.classList.remove('d-none');
                        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    
                    if (form) {
                        form.reset();
                    }
                    
                    setTimeout(() => {
                        window.location.href = '/Vehicles';
                    }, 3000);
                })
                .finally(() => {
                    const submitButton = document.getElementById('submitButton');
                    if (submitButton) {
                        submitButton.disabled = false;
                        submitButton.innerHTML = '<i class="fas fa-save me-2"></i>Salvar Veículo';
                    }
                })
                .catch(error => {
                    const errorMessages = document.getElementById('error-messages');
                    if (!errorMessages) return;
                    
                    if (error.type === 'validation' && error.data) {
                        // Primeiro verifica se há uma mensagem de erro específica da API
                        if (error.data.error) {
                            errorMessages.innerHTML = `<i class="fas fa-exclamation-triangle me-2"></i>${error.data.error}`;
                        }
                        // Se não há mensagem específica, verifica se há erros de validação por campo
                        else if (error.data.errors) {
                            let errorHtml = '<ul class="mb-0">';
                            for (const field in error.data.errors) {
                                error.data.errors[field].forEach(msg => {
                                    errorHtml += `<li><strong>${field}:</strong> ${msg}</li>`;
                                });
                                
                                const fieldElement = document.getElementById(field.toLowerCase());
                                if (fieldElement) {
                                    fieldElement.classList.add('is-invalid');
                                    const feedback = fieldElement.parentElement.querySelector('.invalid-feedback');
                                    if (feedback) {
                                        feedback.textContent = error.data.errors[field][0];
                                    }
                                }
                            }
                            errorHtml += '</ul>';
                            errorMessages.innerHTML = errorHtml;
                        }
                        // Se não há nem mensagem específica nem erros de campo, usa mensagem genérica
                        else {
                            errorMessages.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Dados inválidos. Verifique os campos e tente novamente.';
                        }
                    } else if (error.type === 'error') {
                        let iconClass = 'fas fa-exclamation-triangle';
                        if (error.status >= 500) {
                            iconClass = 'fas fa-server';
                        }
                        
                        errorMessages.innerHTML = `<i class="${iconClass} me-2"></i>${error.message}`;
                    } else {
                        const message = error.message || 'Erro de conexão. Verifique sua internet e tente novamente.';
                        errorMessages.innerHTML = `<i class="fas fa-wifi me-2"></i>${message}`;
                    }
                    
                    errorMessages.classList.remove('d-none');
                    errorMessages.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
            });

            async function loadManufacturers() {
                try {
                    const response = await fetch('/api/manufacturers', {
                        credentials: 'same-origin'
                    });

                    if (response.ok) {
                        const manufacturers = await response.json();
                        const select = document.getElementById('manufacturerId');
                        
                        manufacturers.forEach(manufacturer => {
                            const option = document.createElement('option');
                            option.value = manufacturer.Id;
                            option.textContent = manufacturer.Name;
                            select.appendChild(option);
                        });
                    }
                } catch (error) {
                    console.error('Erro ao carregar fabricantes:', error);
                }
            }

            // Auto-focus no primeiro campo
            document.getElementById('model').focus();
        });
    </script>
}

@section Styles {
    <style>
        .form-floating>.form-control:focus~label,
        .form-floating>.form-control:not(:placeholder-shown)~label {
            opacity: .65;
            transform: scale(.85) translateY(-0.5rem) translateX(0.15rem);
        }

        .form-floating>.form-select~label {
            opacity: .65;
            transform: scale(.85) translateY(-0.5rem) translateX(0.15rem);
        }

        .card {
            border: none;
            border-radius: 0.75rem;
        }

        .card-header {
            border-radius: 0.75rem 0.75rem 0 0 !important;
            border-bottom: 2px solid rgba(255, 255, 255, 0.2);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

        .btn {
            border-radius: 0.5rem;
            font-weight: 500;
            padding: 0.75rem 1.5rem;
        }

        .btn:hover {
            transform: translateY(-1px);
            transition: all 0.2s ease;
        }

        h6 {
            font-weight: 600;
            letter-spacing: 0.025em;
        }
    </style>
}