@{
    ViewData["Title"] = "Clientes";
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-users text-primary me-2"></i>Clientes</h2>
            <p class="text-muted mb-0">Gerencie os clientes cadastrados</p>
        </div>
        <a href="/Customers/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Novo Cliente</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="mb-3">
                <div class="row g-2">
                    <div class="col-md-10">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text" id="searchInput" class="form-control" placeholder="Buscar por nome, CPF ou telefone..." />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="btnBuscar" class="btn btn-primary w-100">Buscar</button>
                    </div>
                </div>
            </div>

            <div id="loading" class="text-center d-none">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
            </div>

            <div id="customers-container">
                <div id="customers-table" class="table-responsive d-none">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>CPF</th>
                                <th>Telefone</th>
                                <th class="text-center" style="width:200px">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="customers-tbody">
                        </tbody>
                    </table>
                </div>

                <div id="no-customers" class="text-center text-muted py-5 d-none">
                    <i class="fas fa-users fa-3x mb-3"></i>
                    <p>Nenhum cliente encontrado.</p>
                    <a href="/Customers/Create" class="btn btn-primary">Cadastrar Primeiro Cliente</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Função global para carregar clientes
        function loadCustomers() {
                const searchTerm = document.getElementById('searchInput').value;
                const loading = document.getElementById('loading');
                const customersTable = document.getElementById('customers-table');
                const noCustomers = document.getElementById('no-customers');
                
                loading.classList.remove('d-none');
                customersTable.classList.add('d-none');
                noCustomers.classList.add('d-none');

                let url = '/api/customers';
                if (searchTerm) {
                    url += `?searchString=${encodeURIComponent(searchTerm)}`;
                }

                fetch(url, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'same-origin'
                })
                .then(response => {
                    
                    if (response.status === 401) {
                        window.location.href = '/Identity/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                        return;
                    }
                    
                    if (!response.ok) {
                        throw new Error(`Erro ${response.status}: ${response.statusText}`);
                    }
                    return response.json();
                })
                .then(data => {
                    loading.classList.add('d-none');
                    
                    if (Array.isArray(data) && data.length > 0) {
                        renderCustomersTable(data);
                        customersTable.classList.remove('d-none');
                    } else {
                        // Mostrar mensagem adequada baseada na busca
                        const noCustomersDiv = document.getElementById('no-customers');
                        if (searchTerm) {
                            noCustomersDiv.innerHTML = `
                                <i class="fas fa-search fa-3x mb-3 text-muted"></i>
                                <p>Nenhum cliente encontrado para "${searchTerm}".</p>
                                <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('searchInput').value=''; loadCustomers();">
                                    Limpar Busca
                                </button>
                            `;
                        } else {
                            noCustomersDiv.innerHTML = `
                                <i class="fas fa-users fa-3x mb-3 text-muted"></i>
                                <p>Nenhum cliente cadastrado.</p>
                                <a href="/Customers/Create" class="btn btn-primary">Cadastrar Primeiro Cliente</a>
                            `;
                        }
                        noCustomers.classList.remove('d-none');
                    }
                })
                .catch(error => {
                    loading.classList.add('d-none');
                    
                    const customersContainer = document.getElementById('customers-container');
                    customersContainer.innerHTML = `
                        <div class="alert alert-danger text-center">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Erro ao carregar clientes:</strong> ${error.message}
                            <br><small class="mt-2 d-block">
                                <button type="button" class="btn btn-outline-danger btn-sm mt-2" onclick="loadCustomers()">
                                    <i class="fas fa-redo me-1"></i>Tentar Novamente
                                </button>
                            </small>
                        </div>
                    `;
                });
        }

        function renderCustomersTable(customers) {
                const tbody = document.getElementById('customers-tbody');
                tbody.innerHTML = '';

                customers.forEach(customer => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td><span class="badge bg-secondary">#${customer.Id || 'N/A'}</span></td>
                        <td>${customer.Name || 'N/A'}</td>
                        <td>${customer.Cpf || 'N/A'}</td>
                        <td>${customer.Phone || 'N/A'}</td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a href="/Customers/Details/${customer.Id}" class="btn btn-outline-info btn-sm" title="Detalhes">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Customers/Edit/${customer.Id}" class="btn btn-outline-warning btn-sm" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-outline-danger btn-sm btn-delete" 
                                        data-id="${customer.Id}" data-name="${customer.Name}" title="Excluir">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(row);
                });

                // Adicionar event listeners para botões de exclusão
                document.querySelectorAll('.btn-delete').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const id = this.getAttribute('data-id');
                        const name = this.getAttribute('data-name');
                        
                        if (confirm(`Tem certeza que deseja excluir o cliente "${name}"?`)) {
                            deleteCustomer(id);
                        }
                    });
                });
        }

        function deleteCustomer(id) {
                fetch(`/api/customers/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => {
                    if (response.ok) {
                        alert('Cliente excluído com sucesso!');
                        loadCustomers();
                    } else {
                        return response.json().then(data => Promise.reject(data));
                    }
                })
                .catch(error => {
                    alert(error.message || 'Erro ao excluir cliente');
                });
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadCustomers();

            // Busca ao pressionar Enter
            document.getElementById('searchInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    loadCustomers();
                }
            });

            // Busca ao clicar no botão
            document.getElementById('btnBuscar').addEventListener('click', function() {
                loadCustomers();
            });
        });
    </script>
}