@{
    ViewData["Title"] = "Detalhes do Cliente";
    var customerId = ViewContext.RouteData.Values["id"]?.ToString();
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-user text-info me-2"></i>Detalhes do Cliente</h2>
            <p class="text-muted mb-0">Informações completas do cliente</p>
        </div>
        <div class="btn-group">
            <a href="/Customers" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Voltar</a>
            <a href="/Customers/Edit/@customerId" class="btn btn-warning text-dark"><i class="fas fa-edit me-2"></i>Editar</a>
        </div>
    </div>

    <div id="loading" class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    </div>

    <div id="customer-details" class="d-none">
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-user me-2"></i>Informações Pessoais</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-3">ID</dt>
                            <dd class="col-sm-9"><span class="badge bg-secondary" id="customer-id"></span></dd>
                            
                            <dt class="col-sm-3">Nome Completo</dt>
                            <dd class="col-sm-9" id="customer-name"></dd>
                            
                            <dt class="col-sm-3">CPF</dt>
                            <dd class="col-sm-9"><code id="customer-cpf"></code></dd>
                            
                            <dt class="col-sm-3">Telefone</dt>
                            <dd class="col-sm-9" id="customer-phone"></dd>
                            
                            <dt class="col-sm-3">Data de Cadastro</dt>
                            <dd class="col-sm-9" id="customer-created"></dd>
                            
                            <dt class="col-sm-3">Status</dt>
                            <dd class="col-sm-9" id="customer-status"></dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-shopping-cart me-2"></i>Histórico de Compras</h5>
                    </div>
                    <div class="card-body" id="sales-container">
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-shopping-cart fa-2x mb-2"></i>
                            <p class="mb-0">Nenhuma compra registrada</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const customerId = '@customerId';
            loadCustomerDetails(customerId);

            async function loadCustomerDetails(id) {
                try {
                    // Carregar dados do cliente e vendas em paralelo
                    const [customerResponse, salesResponse] = await Promise.all([
                        fetch(`/api/customers/${id}`, { credentials: 'same-origin' }),
                        fetch(`/api/sales/customer/${id}`, { credentials: 'same-origin' })
                    ]);

                    if (!customerResponse.ok) {
                        throw new Error('Cliente não encontrado');
                    }

                    const customer = await customerResponse.json();
                    
                    // Preencher informações do cliente
                    document.getElementById('customer-id').textContent = `#${customer.Id}`;
                    document.getElementById('customer-name').textContent = customer.Name || 'N/A';
                    document.getElementById('customer-cpf').textContent = customer.Cpf || 'N/A';
                    document.getElementById('customer-phone').textContent = customer.Phone || 'N/A';

                    // Formatar data de criação (se disponível)
                    if (customer.CreatedAt) {
                        const createdDate = new Date(customer.CreatedAt);
                        document.getElementById('customer-created').textContent = createdDate.toLocaleDateString('pt-BR') + ' ' + createdDate.toLocaleTimeString('pt-BR', {hour: '2-digit', minute: '2-digit'});
                    } else {
                        document.getElementById('customer-created').textContent = 'N/A';
                    }
                    
                    // Status - verificar se IsActive existe e é booleano
                    const statusElement = document.getElementById('customer-status');
                    if (customer.IsActive === true) {
                        statusElement.innerHTML = '<span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Ativo</span>';
                    } else if (customer.IsActive === false) {
                        statusElement.innerHTML = '<span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Inativo</span>';
                    } else {
                        statusElement.innerHTML = '<span class="badge bg-warning"><i class="fas fa-question-circle me-1"></i>Indefinido</span>';
                    }

                    // Carregar histórico de vendas
                    if (salesResponse.ok) {
                        const sales = await salesResponse.json();
                        renderSalesHistory(sales);
                    } else {
                        console.log('Nenhuma venda encontrada para este cliente');
                    }

                    document.getElementById('loading').classList.add('d-none');
                    document.getElementById('customer-details').classList.remove('d-none');
                } catch (error) {
                    console.error('Erro ao carregar dados do cliente:', error);
                    document.getElementById('loading').classList.add('d-none');
                    alert('Erro ao carregar dados do cliente: ' + error.message);
                    window.location.href = '/Customers';
                }
            }

            function renderSalesHistory(sales) {
                if (!sales || sales.length === 0) {
                    return; // Mantém o estado padrão de "Nenhuma venda registrada"
                }

                const totalSales = sales.length;
                const totalValue = sales.reduce((sum, sale) => sum + (sale.SalePrice || 0), 0);

                const salesContainer = document.getElementById('sales-container');
                salesContainer.innerHTML = `
                    <div class="mb-3">
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="border-end">
                                    <h4 class="text-primary mb-0">${totalSales}</h4>
                                    <small class="text-muted">Compras</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <h4 class="text-success mb-0">${formatCurrency(totalValue)}</h4>
                                <small class="text-muted">Total</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="list-group" id="sales-list">
                    </div>

                    ${totalSales > 5 ? '<a href="/Sales" class="btn btn-sm btn-outline-primary mt-3 w-100">Ver Todas as Compras</a>' : ''}
                `;

                const salesList = document.getElementById('sales-list');
                sales.slice(0, 5).forEach(sale => {
                    const saleDate = new Date(sale.SaleDate);
                    const saleElement = document.createElement('a');
                    saleElement.href = `/Sales/Details/${sale.Id}`;
                    saleElement.className = 'list-group-item list-group-item-action';
                    saleElement.innerHTML = `
                        <div class="d-flex w-100 justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">${sale.VehicleModel || 'Veículo N/A'}</h6>
                                    <strong class="text-success">${formatCurrency(sale.SalePrice)}</strong>
                                </div>
                                <p class="mb-1 text-muted small">${sale.DealershipName || 'Concessionária N/A'}</p>
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>${saleDate.toLocaleDateString('pt-BR')} • 
                                    <i class="fas fa-receipt me-1"></i>${sale.Protocol}
                                </small>
                            </div>
                        </div>
                    `;
                    salesList.appendChild(saleElement);
                });
            }

            function formatCurrency(value) {
                return new Intl.NumberFormat('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                }).format(value || 0);
            }
        });
    </script>
}
</div>
