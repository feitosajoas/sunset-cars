@{
    ViewData["Title"] = "Editar Concessionária";
}

<!-- Loading Indicator -->
<div id="loadingIndicator" class="text-center py-5">
    <div class="spinner-border text-warning" role="status">
        <span class="visually-hidden">Carregando...</span>
    </div>
    <p class="mt-3 text-muted">Carregando dados da concessionária...</p>
</div>

<!-- Main Content -->
<div id="dealershipForm" class="d-none">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1"><i class="fas fa-edit text-warning me-2"></i>Editar Concessionária</h2>
                <p class="text-muted mb-0">Atualize as informações da concessionária <span id="dealershipIdDisplay" class="badge bg-secondary"></span></p>
            </div>
            <a href="/Dealerships" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Voltar</a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fas fa-building me-2"></i>Informações da Concessionária</h5>
                    </div>
                    <div class="card-body">
                        <!-- Alert para erros de validação -->
                        <div id="validationErrors" class="alert alert-danger d-none">
                            <ul id="errorsList" class="mb-0"></ul>
                        </div>

                        <form id="editDealershipForm">
                            <input type="hidden" id="dealershipId" />

                            <div class="form-floating mb-3">
                                <input type="text" id="name" class="form-control" placeholder="Nome" required maxlength="100" />
                                <label for="name">Nome <span class="text-danger">*</span></label>
                                <div class="invalid-feedback"></div>
                            </div>

                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-floating mb-3">
                                        <input type="text" id="address" class="form-control" placeholder="Endereço" required maxlength="200" />
                                        <label for="address">Endereço <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating mb-3">
                                        <input type="text" id="zipCode" class="form-control" placeholder="CEP" required maxlength="9" />
                                        <label for="zipCode">CEP <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                        <div class="form-text">Exemplo: 12345-678</div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input type="text" id="city" class="form-control" placeholder="Cidade" required maxlength="50" />
                                        <label for="city">Cidade <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-floating mb-3">
                                        <input type="text" id="state" class="form-control" placeholder="Estado" required maxlength="2" />
                                        <label for="state">UF <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                        <div class="form-text">Ex: SP</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating mb-3">
                                        <input type="tel" id="phone" class="form-control" placeholder="Telefone" required maxlength="15" />
                                        <label for="phone">Telefone <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                        <div class="form-text">Ex: (11) 99999-9999</div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-floating mb-3">
                                        <input type="email" id="email" class="form-control" placeholder="E-mail" required maxlength="100" />
                                        <label for="email">E-mail <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                        <div class="form-text">Exemplo: contato@concessionaria.com</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating mb-3">
                                        <input type="number" id="maxCapacity" class="form-control" placeholder="Capacidade" 
                                               min="1" max="9999" required />
                                        <label for="maxCapacity">Capacidade <span class="text-danger">*</span></label>
                                        <div class="invalid-feedback"></div>
                                        <div class="form-text">Número de veículos</div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-check mb-4">
                                <input type="checkbox" id="isActive" class="form-check-input" />
                                <label for="isActive" class="form-check-label">
                                    <i class="fas fa-check-circle text-success me-1"></i>Concessionária ativa
                                </label>
                                <div class="form-text">Concessionárias inativas não aparecem nas listas de seleção</div>
                            </div>

                            <div class="d-flex justify-content-between">
                                <a href="/Dealerships" class="btn btn-outline-secondary">
                                    <i class="fas fa-times me-2"></i>Cancelar
                                </a>
                                <button type="submit" class="btn btn-warning text-dark" id="saveButton">
                                    <span class="spinner-border spinner-border-sm me-2 d-none" id="saveSpinner"></span>
                                    <i class="fas fa-save me-2" id="saveIcon"></i>Salvar Alterações
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const dealershipId = window.location.pathname.split('/').pop();
            
            if (!dealershipId || dealershipId === 'Edit') {
                window.location.href = '/Dealerships';
                return;
            }

            loadDealershipData(dealershipId);
            setupFormSubmission();
            setupCepLookup();

            async function loadDealershipData(id) {
                try {
                    const response = await fetch(`/api/dealerships/${id}`, {
                        credentials: 'same-origin'
                    });

                    if (!response.ok) {
                        throw new Error('Concessionária não encontrada');
                    }

                    const dealership = await response.json();
                    populateForm(dealership);
                    
                    document.getElementById('loadingIndicator').classList.add('d-none');
                    document.getElementById('dealershipForm').classList.remove('d-none');
                } catch (error) {
                    console.error('Erro ao carregar concessionária:', error);
                    showError();
                }
            }

            function populateForm(dealership) {
                document.getElementById('dealershipId').value = dealership.Id;
                document.getElementById('dealershipIdDisplay').textContent = `#${dealership.Id}`;
                document.getElementById('name').value = dealership.Name || '';
                document.getElementById('address').value = dealership.Address || '';
                document.getElementById('zipCode').value = dealership.ZipCode || '';
                document.getElementById('city').value = dealership.City || '';
                document.getElementById('state').value = dealership.State || '';
                document.getElementById('phone').value = dealership.Phone || '';
                document.getElementById('email').value = dealership.Email || '';
                document.getElementById('maxCapacity').value = dealership.MaxCapacity || '';
                document.getElementById('isActive').checked = dealership.IsActive || false;
            }

            function setupCepLookup() {
                document.getElementById('zipCode').addEventListener('blur', async function() {
                    const cep = this.value.replace(/\D/g, '');
                    if (cep.length !== 8) return;

                    try {
                        const response = await fetch(`/api/dealerships/cep/${cep}`, {
                            credentials: 'same-origin'
                        });

                        if (response.ok) {
                            const data = await response.json();
                            document.getElementById('city').value = data.city || '';
                            document.getElementById('state').value = data.state || '';
                            if (data.street) {
                                document.getElementById('address').value = data.street;
                            }
                        }
                    } catch (error) {
                        console.error('Erro ao buscar CEP:', error);
                    }
                });
            }

            function setupFormSubmission() {
                const form = document.getElementById('editDealershipForm');
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    // Limpar erros anteriores
                    clearValidationErrors();
                    
                    // Mostrar loading
                    const saveButton = document.getElementById('saveButton');
                    const saveSpinner = document.getElementById('saveSpinner');
                    const saveIcon = document.getElementById('saveIcon');
                    
                    saveButton.disabled = true;
                    saveSpinner.classList.remove('d-none');
                    saveIcon.classList.add('d-none');

                    try {
                        const formData = {
                            Id: parseInt(document.getElementById('dealershipId').value),
                            Name: document.getElementById('name').value.trim(),
                            Address: document.getElementById('address').value.trim(),
                            ZipCode: document.getElementById('zipCode').value.trim(),
                            City: document.getElementById('city').value.trim(),
                            State: document.getElementById('state').value.trim().toUpperCase(),
                            Phone: document.getElementById('phone').value.trim(),
                            Email: document.getElementById('email').value.trim(),
                            MaxCapacity: parseInt(document.getElementById('maxCapacity').value),
                            IsActive: document.getElementById('isActive').checked
                        };

                        const response = await fetch(`/api/dealerships/${formData.Id}`, {
                            method: 'PUT',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            credentials: 'same-origin',
                            body: JSON.stringify(formData)
                        });

                        if (response.ok) {
                            showToast('Concessionária atualizada com sucesso!', 'success');
                            
                            // Redirecionar após sucesso
                            setTimeout(() => {
                                window.location.href = '/Dealerships';
                            }, 2000);
                        } else {
                            const errorData = await response.json();
                            
                            if (response.status === 400) {
                                // Erros de validação
                                if (errorData.validationErrors) {
                                    showValidationErrors(errorData.validationErrors);
                                } else {
                                    showToast(errorData.error || 'Erro de validação', 'error');
                                }
                            } else {
                                showToast(errorData.error || 'Erro ao atualizar concessionária', 'error');
                            }
                        }
                    } catch (error) {
                        console.error('Erro ao atualizar concessionária:', error);
                        showToast('Erro de conexão ao atualizar concessionária', 'error');
                    } finally {
                        // Restaurar botão
                        saveButton.disabled = false;
                        saveSpinner.classList.add('d-none');
                        saveIcon.classList.remove('d-none');
                    }
                });
            }

            function showValidationErrors(errors) {
                const errorsList = document.getElementById('errorsList');
                const validationErrors = document.getElementById('validationErrors');
                
                errorsList.innerHTML = '';
                
                // Limpar classes de erro dos campos
                document.querySelectorAll('.form-control').forEach(field => {
                    field.classList.remove('is-invalid');
                });

                for (const [field, messages] of Object.entries(errors)) {
                    messages.forEach(message => {
                        const li = document.createElement('li');
                        li.textContent = message;
                        errorsList.appendChild(li);
                    });

                    // Destacar campo com erro
                    const fieldElement = document.getElementById(field.toLowerCase());
                    if (fieldElement) {
                        fieldElement.classList.add('is-invalid');
                        const feedback = fieldElement.nextElementSibling?.nextElementSibling;
                        if (feedback && feedback.classList.contains('invalid-feedback')) {
                            feedback.textContent = messages[0];
                        }
                    }
                }
                
                validationErrors.classList.remove('d-none');
                validationErrors.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            function clearValidationErrors() {
                document.getElementById('validationErrors').classList.add('d-none');
                document.querySelectorAll('.form-control').forEach(field => {
                    field.classList.remove('is-invalid');
                });
            }

            function showError() {
                document.getElementById('loadingIndicator').innerHTML = `
                    <div class="text-center py-5">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                        <h4 class="text-danger">Erro ao carregar dados</h4>
                        <p class="text-muted">Não foi possível carregar os dados da concessionária</p>
                        <a href="/Dealerships" class="btn btn-primary">
                            <i class="fas fa-arrow-left me-2"></i>Voltar à Lista
                        </a>
                    </div>
                `;
            }

            function showToast(message, type) {
                // Criar toast dinamicamente
                const toastHtml = `
                    <div class="toast align-items-center text-white ${type === 'success' ? 'bg-success' : 'bg-danger'} border-0" role="alert">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas ${type === 'success' ? 'fa-check' : 'fa-exclamation-triangle'} me-2"></i>
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                `;
                
                // Adicionar ao container de toasts (criar se não existir)
                let toastContainer = document.getElementById('toast-container');
                if (!toastContainer) {
                    toastContainer = document.createElement('div');
                    toastContainer.id = 'toast-container';
                    toastContainer.className = 'toast-container position-fixed top-0 end-0 p-3';
                    document.body.appendChild(toastContainer);
                }
                
                toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                
                // Inicializar e mostrar o toast
                const toastElement = toastContainer.lastElementChild;
                const toast = new bootstrap.Toast(toastElement);
                toast.show();
                
                // Remover o elemento após esconder
                toastElement.addEventListener('hidden.bs.toast', () => {
                    toastElement.remove();
                });
            }
        });
    </script>
}