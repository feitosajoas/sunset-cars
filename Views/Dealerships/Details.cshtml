@{
    ViewData["Title"] = "Detalhes da Concessionária";
}

<!-- Loading Indicator -->
<div id="loadingIndicator" class="text-center py-5">
    <div class="spinner-border text-info" role="status">
        <span class="visually-hidden">Carregando...</span>
    </div>
    <p class="mt-3 text-muted">Carregando detalhes da concessionária...</p>
</div>

<!-- Main Content -->
<div id="dealershipDetails" class="d-none">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1" id="dealershipTitle">
                    <i class="fas fa-eye text-info me-2"></i>Detalhes da Concessionária
                </h2>
                <p class="text-muted mb-0">
                    Informações e vendas associadas <span id="dealershipId" class="badge bg-secondary"></span>
                </p>
            </div>
            <div class="btn-group">
                <a href="/Dealerships" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </a>
            </div>
        </div>

        <div class="row">
            <!-- Informações da Concessionária -->
            <div class="col-lg-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-building me-2"></i>Informações Gerais</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">ID</dt>
                            <dd class="col-sm-8" id="dealershipIdField">#-</dd>
                            
                            <dt class="col-sm-4">Nome</dt>
                            <dd class="col-sm-8" id="dealershipName">-</dd>
                            
                            <dt class="col-sm-4">Endereço</dt>
                            <dd class="col-sm-8" id="dealershipAddress">-</dd>
                            
                            <dt class="col-sm-4">Cidade/UF</dt>
                            <dd class="col-sm-8" id="dealershipLocation">-</dd>
                            
                            <dt class="col-sm-4">CEP</dt>
                            <dd class="col-sm-8" id="dealershipZipCode">-</dd>
                            
                            <dt class="col-sm-4">Telefone</dt>
                            <dd class="col-sm-8" id="dealershipPhone">-</dd>
                            
                            <dt class="col-sm-4">E-mail</dt>
                            <dd class="col-sm-8" id="dealershipEmail">-</dd>
                            
                            <dt class="col-sm-4">Capacidade</dt>
                            <dd class="col-sm-8" id="dealershipCapacity">-</dd>
                            
                            <dt class="col-sm-4">Criado em</dt>
                            <dd class="col-sm-8" id="dealershipCreatedAt">-</dd>
                            
                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8" id="dealershipStatus">-</dd>
                        </dl>
                    </div>
                    <div class="card-footer d-flex justify-content-end gap-2">
                        <a id="editLink" href="#" class="btn btn-warning text-dark">
                            <i class="fas fa-edit me-2"></i>Editar
                        </a>
                        <button id="deleteButton" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Excluir
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Vendas da Concessionária -->
            <div class="col-lg-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-handshake me-2"></i>Vendas</h5>
                        <span id="salesCount" class="badge bg-light text-dark">0</span>
                    </div>
                    <div class="card-body">
                        <!-- Loading para Vendas -->
                        <div id="salesLoading" class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-success" role="status">
                                <span class="visually-hidden">Carregando vendas...</span>
                            </div>
                            <p class="mt-2 mb-0 text-muted small">Carregando vendas...</p>
                        </div>
                        
                        <!-- Lista de Vendas -->
                        <div id="salesList" class="d-none">
                            <ul id="salesUl" class="list-group list-group-flush">
                                <!-- Vendas serão carregadas via JavaScript -->
                            </ul>
                        </div>
                        
                        <!-- Estado Vazio -->
                        <div id="salesEmpty" class="text-center py-4 d-none">
                            <i class="fas fa-handshake fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">Nenhuma venda registrada</p>
                            <small class="text-muted">Esta concessionária ainda não realizou vendas</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const dealershipId = window.location.pathname.split('/').pop();
            
            if (!dealershipId || dealershipId === 'Details') {
                window.location.href = '/Dealerships';
                return;
            }

            loadDealershipDetails(dealershipId);

            async function loadSales(dealershipId) {
                try {
                    const response = await fetch(`/api/sales/dealership/${dealershipId}`, {
                        credentials: 'same-origin'
                    });

                    if (response.ok) {
                        const sales = await response.json();
                        populateSales(sales);
                    } else {
                        console.error('Erro ao carregar vendas:', response.statusText);
                        populateSales([]);
                    }
                } catch (error) {
                    console.error('Erro ao carregar vendas:', error);
                    populateSales([]);
                }
            }

            async function loadDealershipDetails(id) {
                try {
                    // Carregar dados da concessionária
                    const dealershipResponse = await fetch(`/api/dealerships/${id}`, { 
                        credentials: 'same-origin' 
                    });

                    if (!dealershipResponse.ok) {
                        throw new Error('Concessionária não encontrada');
                    }

                    const dealership = await dealershipResponse.json();
                    populateDetails(dealership);
                    
                    // Carregar vendas da concessionária
                    await loadSales(id);
                    
                    document.getElementById('loadingIndicator').classList.add('d-none');
                    document.getElementById('dealershipDetails').classList.remove('d-none');
                } catch (error) {
                    console.error('Erro ao carregar concessionária:', error);
                    showError();
                }
            }

            function populateDetails(dealership) {
                document.getElementById('dealershipTitle').innerHTML = `
                    <i class="fas fa-eye text-info me-2"></i>${dealership.Name}
                `;
                document.getElementById('dealershipId').textContent = `#${dealership.Id}`;
                document.getElementById('dealershipIdField').textContent = `#${dealership.Id}`;
                document.getElementById('dealershipName').textContent = dealership.Name || 'N/A';
                document.getElementById('dealershipAddress').textContent = dealership.Address || 'N/A';
                document.getElementById('dealershipLocation').textContent = 
                    `${dealership.City || 'N/A'}/${dealership.State || 'N/A'}`;
                document.getElementById('dealershipZipCode').textContent = dealership.ZipCode || 'N/A';
                
                const phoneElement = document.getElementById('dealershipPhone');
                phoneElement.textContent = dealership.Phone || 'N/A';
                
                const emailElement = document.getElementById('dealershipEmail');
                if (dealership.Email) {
                    emailElement.innerHTML = `<a href="mailto:${dealership.Email}" class="text-decoration-none">
                        <i class="fas fa-envelope me-1"></i>${dealership.Email}
                    </a>`;
                } else {
                    emailElement.textContent = 'N/A';
                }
                
                document.getElementById('dealershipCapacity').innerHTML = `
                    <span class="badge bg-info">
                        <i class="fas fa-car me-1"></i>${dealership.MaxCapacity || 0} veículos
                    </span>
                `;
                
                const createdAt = new Date(dealership.CreatedAt);
                document.getElementById('dealershipCreatedAt').textContent = 
                    createdAt.toLocaleDateString('pt-BR');
                
                document.getElementById('dealershipStatus').innerHTML = dealership.IsActive ? 
                    '<span class="badge bg-success"><i class="fas fa-check me-1"></i> Ativo</span>' :
                    '<span class="badge bg-danger"><i class="fas fa-times me-1"></i> Inativo</span>';

                // Atualizar links
                document.getElementById('editLink').href = `/Dealerships/Edit/${dealership.Id}`;
                
                // Configurar botão de exclusão
                const deleteButton = document.getElementById('deleteButton');
                deleteButton.addEventListener('click', function() {
                    document.getElementById('deleteDealershipName').textContent = dealership.Name;
                    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
                    modal.show();
                });

                // Configurar confirmação de exclusão
                document.getElementById('confirmDelete').addEventListener('click', async function() {
                    try {
                        const response = await fetch(`/api/dealerships/${dealership.Id}`, {
                            method: 'DELETE',
                            credentials: 'same-origin'
                        });

                        if (response.ok) {
                            // Fechar modal
                            bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                            
                            // Mostrar sucesso
                            showToast('Concessionária excluída com sucesso!', 'success');
                            
                            // Redirecionar após um tempo
                            setTimeout(() => {
                                window.location.href = '/Dealerships';
                            }, 2000);
                        } else {
                            const errorData = await response.json();
                            showToast(errorData.error || 'Erro ao excluir concessionária', 'error');
                        }
                    } catch (error) {
                        console.error('Erro ao excluir concessionária:', error);
                        showToast('Erro ao excluir concessionária', 'error');
                    }
                });
            }

            function populateSales(sales) {
                document.getElementById('salesLoading').classList.add('d-none');
                document.getElementById('salesCount').textContent = sales.length;

                if (sales.length === 0) {
                    document.getElementById('salesEmpty').classList.remove('d-none');
                    return;
                }

                document.getElementById('salesList').classList.remove('d-none');
                const salesUl = document.getElementById('salesUl');
                
                salesUl.innerHTML = sales.map(sale => `
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-handshake text-success me-2"></i>
                                <div>
                                    <strong>${sale.CustomerName}</strong>
                                    <br>
                                    <small class="text-muted">
                                        ${sale.VehicleModel} (${sale.VehicleYear}) • 
                                        ${formatDate(sale.SaleDate)} •
                                        Protocolo: ${sale.Protocol}
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-success fs-6">
                                ${formatCurrency(sale.SalePrice)}
                            </span>
                            <br>
                            <a href="/Sales/Details/${sale.Id}" class="btn btn-outline-info btn-sm mt-1">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </li>
                `).join('');
            }

            function formatCurrency(value) {
                return new Intl.NumberFormat('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                }).format(value);
            }

            function formatDate(dateString) {
                return new Date(dateString).toLocaleDateString('pt-BR');
            }

            function showError() {
                document.getElementById('loadingIndicator').innerHTML = `
                    <div class="text-center py-5">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                        <h4 class="text-danger">Erro ao carregar dados</h4>
                        <p class="text-muted">Não foi possível carregar os detalhes da concessionária</p>
                        <a href="/Dealerships" class="btn btn-primary">
                            <i class="fas fa-arrow-left me-2"></i>Voltar à Lista
                        </a>
                    </div>
                `;
            }

            function showToast(message, type) {
                // Criar toast dinamicamente
                const toastHtml = `
                    <div class="toast align-items-center text-white ${type === 'success' ? 'bg-success' : 'bg-danger'} border-0" role="alert">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas ${type === 'success' ? 'fa-check' : 'fa-exclamation-triangle'} me-2"></i>
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                `;
                
                // Adicionar ao container de toasts (criar se não existir)
                let toastContainer = document.getElementById('toast-container');
                if (!toastContainer) {
                    toastContainer = document.createElement('div');
                    toastContainer.id = 'toast-container';
                    toastContainer.className = 'toast-container position-fixed top-0 end-0 p-3';
                    document.body.appendChild(toastContainer);
                }
                
                toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                
                // Inicializar e mostrar o toast
                const toastElement = toastContainer.lastElementChild;
                const toast = new bootstrap.Toast(toastElement);
                toast.show();
                
                // Remover o elemento após esconder
                toastElement.addEventListener('hidden.bs.toast', () => {
                    toastElement.remove();
                });
            }
        });
    </script>
}

<!-- Modal de Confirmação para Exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Exclusão
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <i class="fas fa-building fa-2x text-danger"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-1">Você tem certeza?</h6>
                        <p class="text-muted mb-0">
                            Esta ação excluirá permanentemente a concessionária
                            <strong id="deleteDealershipName"></strong>.
                        </p>
                    </div>
                </div>
                <div class="alert alert-warning mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Atenção:</strong> Esta ação não pode ser desfeita e também excluirá todas as vendas associadas.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="confirmDelete">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="deleteSpinner"></span>
                    <i class="fas fa-trash me-2" id="deleteIcon"></i>Excluir Concessionária
                </button>
            </div>
        </div>
    </div>
</div>